# ============================================
# CloudIQ Backend - Environment Configuration
# Copy this file as .env and fill in your values
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-session-secret-here

# IBM App ID Configuration
APPID_TENANT_ID=your-tenant-id
APPID_CLIENT_ID=your-client-id
APPID_SECRET=your-app-secret
APPID_OAUTH_SERVER_URL=https://region.appid.cloud.ibm.com/oauth/v4/your-tenant-id
APPID_REDIRECT_URI=http://localhost:5000/auth/callback
APPID_DISCOVERY_ENDPOINT=https://region.appid.cloud.ibm.com/oauth/v4/your-tenant-id/.well-known/openid-configuration
APPID_PROFILES_URL=https://region.appid.cloud.ibm.com
APPID_MANAGEMENT_URL=https://region.appid.cloud.ibm.com/management/v4/your-tenant-id
APPID_API_KEY=your-api-key

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Orion AI (NVIDIA NIM)
# Get an API key from NVIDIA Build/API Catalog.
# The model must include the publisher prefix, for example: moonshotai/kimi-k2-instruct
ORION_API_KEY=nvapi-your-nvidia-api-key
ORION_MODEL=moonshotai/kimi-k2-instruct
ORION_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
ORION_API_TIMEOUT_MS=60000

# Admin Role ID (from IBM App ID)
ADMIN_ROLE_ID=your-admin-role-id
ADMIN_ROLE_NAME=admin

# Firebase Admin Configuration (for syncing channel metadata to Firebase)
# Get these from Firebase Console: Project Settings > Service Accounts > Generate New Private Key
# Download the JSON file and save it as firebase-service-account.json in the backend root
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com


# GitHub OAuth + Codespaces Labs
# OAuth app callback URL: http://localhost:5000/api/github/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
GITHUB_API_VERSION=2026-03-10
LAB_TTL_MINUTES=30
LAB_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret-used-only-for-lab-token-encryption
