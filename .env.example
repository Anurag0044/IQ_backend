# ============================================
# CloudIQ Backend — Environment Configuration
# Copy to .env and fill in your real values
# ============================================

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ── URLs ─────────────────────────────────────────────────────
# Your deployed frontend origin (no trailing slash)
FRONTEND_URL=http://localhost:5173
# Your deployed backend origin
BACKEND_URL=http://localhost:5000
# Extra allowed CORS origins (comma-separated, optional)
CORS_ALLOWED_ORIGINS=

# ── Session (needed for GitHub OAuth only) ─────────────────
SESSION_SECRET=change-this-to-a-long-random-string-min-32-chars

# ── Firebase Admin SDK ────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=cloudiq-c4af1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cloudiq-c4af1.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Note: Asia Southeast 1 region — match the actual Realtime Database URL from Firebase console
FIREBASE_DATABASE_URL=https://cloudiq-c4af1-default-rtdb.asia-southeast1.firebasedatabase.app

# ── Admin Access ──────────────────────────────────────────────
# Comma-separated list of emails that are automatically super-admin (main_admin role)
ADMIN_EMAILS=your@email.com

# ── Orion AI (NVIDIA NIM) ─────────────────────────────────────
# Get API key from: https://build.nvidia.com
ORION_API_KEY=nvapi-your-nvidia-api-key-here
ORION_MODEL=moonshotai/kimi-k2-instruct
ORION_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
ORION_API_TIMEOUT_MS=60000

# ── Cloudinary (media uploads) ────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── GitHub OAuth (for Labs / Codespaces) ─────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Callback URL must be: BACKEND_URL/api/github/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
GITHUB_API_VERSION=2022-11-28
LAB_TTL_MINUTES=30
LAB_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars-random-secret

# ── Optional: Firestore Debug Route ──────────────────────────
# Set to 'true' only in dev/staging to expose GET /api/debug/firestore
FIRESTORE_DEBUG_ROUTE_ENABLED=false
